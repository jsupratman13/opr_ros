<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- head joints -->
  <joint name="head_yaw_joint" type="revolute">
    <parent link="body_link"/>
    <child link="head_yaw_link"/>
    <origin xyz="0 0 0.0875" rpy="0 0 0"/>
    <limit effort="100" lower="${-3*PI/4}" upper="${3*PI/4}" velocity="4.8"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- head link -->
  <link name="head_yaw_link">
    <inertial>
      <origin xyz="0.019189 -0.000533 0.057803" rpy="0.00523598 -0.719842 0.00436332"/>
      <mass value="0.160477"/>
      <inertia ixx="0.135811588" ixy="0.293359" iyy="0.151374671" ixz="0.41997404" iyz="0.078967" izz="0.124729778"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://opr_description/meshes/version4/Head.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0045492063207171664 8.625779647839552e-19 0.049218710724377945" rpy="-3.141592653589793 0.5153769953275367 -1.2246467991473535e-16"/>
      <geometry>
        <box size="0.06765749574662422 0.07400000095367433 0.1137128056371003"/>
      </geometry>
    </collision>
  </link>
</robot>
