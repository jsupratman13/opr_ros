<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arm_gazebo" params="name">
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <gravity>false</gravity>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>

  <xacro:arm_gazebo name="left_shoulder_link"/>
  <xacro:arm_gazebo name="left_arm_link"/>
  <xacro:arm_gazebo name="left_forearm_link"/>

  <xacro:arm_gazebo name="right_shoulder_link"/>
  <xacro:arm_gazebo name="right_arm_link"/>
  <xacro:arm_gazebo name="right_forearm_link"/>
</robot>
