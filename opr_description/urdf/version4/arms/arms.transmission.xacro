<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arm_transmission" params="name">
    <transmission name="${name}_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${name}_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <xacro:arm_transmission name="left_shoulder_pitch_joint"/>
  <!-- <xacro:arm_transmission name="left_shoulder_roll_joint"/> -->
  <xacro:arm_transmission name="left_elbow_pitch_joint"/>

  <xacro:arm_transmission name="right_shoulder_pitch_joint"/>
  <!-- <xacro:arm_transmission name="right_shoulder_roll_joint"/> -->
  <xacro:arm_transmission name="right_elbow_pitch_joint"/>
</robot>
