<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mimic_joint" params="name parent multiplier:=1.0">
    <gazebo>
      <plugin name="${name}_plugin" filename="libroboticsgroup_gazebo_mimic_joint_plugin.so">
        <joint>${parent}</joint>
        <mimicJoint>${name}</mimicJoint>
        <multiplier>${multiplier}</multiplier>
        <offset>0.0</offset>
        <sensitiveness>0.0</sensitiveness>
      </plugin>
    </gazebo>
  </xacro:macro>
  <xacro:macro name="leg_gazebo" params="name">
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>10000.0</kp>
      <kd>100.0</kd>
      <gravity>false</gravity>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>

  <xacro:leg_gazebo name="left_waist_yaw_link"/>
  <xacro:leg_gazebo name="left_waist_roll_link"/>
  <xacro:leg_gazebo name="left_thigh_link"/>
  <xacro:leg_gazebo name="left_knee_link"/>
  <xacro:leg_gazebo name="left_shin_link"/>
  <xacro:leg_gazebo name="left_ankle_side_link"/>
  <xacro:leg_gazebo name="left_ankle_link"/>
  <xacro:leg_gazebo name="left_foot_link"/>
  <xacro:leg_gazebo name="left_slider_crank_link"/>
  <xacro:leg_gazebo name="left_hamstring_link"/>
  <xacro:leg_gazebo name="left_calf_link"/>

  <xacro:mimic_joint name="left_slider_crank_mimic_joint" parent="left_waist_roll_joint" multiplier="-2"/>
  <xacro:mimic_joint name="left_hamstring_mimic_joint" parent="left_waist_pitch_joint" multiplier="1"/>
  <xacro:mimic_joint name="left_knee_pitch_mimic_joint" parent="left_waist_pitch_joint" multiplier="-1"/>
  <xacro:mimic_joint name="left_calf_mimic_joint" parent="left_knee_pitch_joint" multiplier="1"/>
  <xacro:mimic_joint name="left_ankle_pitch_mimic_joint" parent="left_knee_pitch_joint" multiplier="-1"/>

  <xacro:leg_gazebo name="right_waist_yaw_link"/>
  <xacro:leg_gazebo name="right_waist_roll_link"/>
  <xacro:leg_gazebo name="right_thigh_link"/>
  <xacro:leg_gazebo name="right_knee_link"/>
  <xacro:leg_gazebo name="right_shin_link"/>
  <xacro:leg_gazebo name="right_ankle_side_link"/>
  <xacro:leg_gazebo name="right_ankle_link"/>
  <xacro:leg_gazebo name="right_foot_link"/>
  <xacro:leg_gazebo name="right_slider_crank_link"/>
  <xacro:leg_gazebo name="right_hamstring_link"/>
  <xacro:leg_gazebo name="right_calf_link"/>

  <xacro:mimic_joint name="right_slider_crank_mimic_joint" parent="right_waist_roll_joint" multiplier="-2"/>
  <xacro:mimic_joint name="right_hamstring_mimic_joint" parent="right_waist_pitch_joint" multiplier="1"/>
  <xacro:mimic_joint name="right_knee_pitch_mimic_joint" parent="right_waist_pitch_joint" multiplier="-1"/>
  <xacro:mimic_joint name="right_calf_mimic_joint" parent="right_knee_pitch_joint" multiplier="1"/>
  <xacro:mimic_joint name="right_ankle_pitch_mimic_joint" parent="right_knee_pitch_joint" multiplier="-1"/>
</robot>
