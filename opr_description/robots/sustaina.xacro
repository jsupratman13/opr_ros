<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sustaina">
  <!--Constants
  for robot dimensions -->
  <xacro:property name="PI" value="3.1415926535897931"/>

  <!-- Import Rviz color -->
  <xacro:include filename="$(find opr_description)/xacro/materials.xacro"/>

  <!-- import empty link -->
  <link name="base_link"/>
  <!-- uncomment this part to fixed the body in space (ignore gravity) -->
  <!--<link name="world"/>-->
  <!--<joint name="world2base" type="fixed">-->
  <!--  <origin xyz="0 0 0" rpy="0 0 0"/>-->
  <!--  <parent link="world"/>-->
  <!--  <child link="base_link"/>-->
  <!--</joint>-->

  <!-- import robot parts -->
  <xacro:include filename="$(find opr_description)/xacro/sustaina/body/body.urdf.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/head/head.urdf.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/arms/left_arm.urdf.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/arms/right_arm.urdf.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/legs/left_leg.urdf.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/legs/right_leg.urdf.xacro"/>

  <!-- gazebo reference -->
  <xacro:include filename="$(find opr_description)/xacro/gazebo.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/body/body.gazebo.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/head/head.gazebo.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/arms/arms.gazebo.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/legs/legs.gazebo.xacro"/>

  <!-- transmission -->
  <xacro:include filename="$(find opr_description)/xacro/sustaina/head/head.transmission.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/arms/arms.transmission.xacro"/>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/legs/legs.transmission.xacro"/>

  <!-- sensors -->
  <xacro:include filename="$(find opr_description)/xacro/sustaina/sensors/imu.xacro"/>
  <xacro:imu name="imu" parent="body_link" update_rate="10">
    <origin xyz="0 0 0.126340" rpy="0 0 0"/>
  </xacro:imu>
  <xacro:include filename="$(find opr_description)/xacro/sustaina/sensors/camera.xacro"/>
  <xacro:camera name="camera" parent="head_yaw_link">
    <origin xyz="0.040411 0 0.045589" rpy="0 ${PI /4} 0"/>
  </xacro:camera>
</robot>
