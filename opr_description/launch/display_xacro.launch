<?xml version="1.0"?>
<launch>
  <arg name="version" default="4"/>
  <param name="robot_description" command="xacro $(find opr_description)/robots/gankenkun_v$(arg version).xacro" />
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find opr_description)/rviz/urdf.rviz"/>
</launch>
