<?xml version="1.0"?>
<launch>
  <!-- model arguement -->
  <arg name="model" default="$(find opr_description)/robots/gankenkun_v4.xacro"/>
  <!-- load gazebo controller -->

  <!-- load ros controller -->
  <include file="$(find opr_ros_control)/launch/ros_control_v4.launch"/>
  <!--<rosparam command="load" file="$(find opr_ros_control)/config/version4/gazebo_controller.yaml"/>-->

  <!-- load gazebo -->
  <include file="$(find opr_gazebo)/launch/gazebo.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="paused" value="true"/>
  </include>

  <!-- publish ground truth -->
  <!--<include file="$(find opr_gazebo)/launch/ground_truth_publisher.launch"/>-->
</launch>
