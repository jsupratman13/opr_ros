<?xml version="1.0"?>
<launch>
  <arg name="model" value="$(find opr_description)/robots/gankenkun_v4.xacro"/>
  <param name="robot_description" command="xacro $(arg model)"/>
  <node name="sustaina_hw_interface" pkg="b3m_hw_interface" type="b3m_hw_interface_node" output="screen">
    <rosparam file="$(find opr_bringup)/config/sustaina.yaml" command="load"/>
  </node>
  <include file="$(find opr_ros_control)/launch/ros_control_v4.launch"/>
</launch>
